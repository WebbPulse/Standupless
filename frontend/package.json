{
  "name": "standupless-frontend",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:staging": "VITE_BACKEND=staging vite",
    "dev:production": "VITE_BACKEND=production vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\" \"*.{ts,tsx,json}\" \".prettierrc.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\" \"*.{ts,tsx,json}\" \".prettierrc.json\"",
    "preview": "vite preview",
    "start": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "type-check": "tsc -b --noEmit",
    "check:csp-hashes": "node --experimental-strip-types cspHashes.ts"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-hard-break": "^3.31.3",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-paragraph": "^3.31.3",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@webbpulse/api-client": ">=0.23.0 <1",
    "@webbpulse/auth": ">=0.30.0 <1",
    "@webbpulse/config": ">=0.14.0 <1",
    "@webbpulse/discovery": ">=0.13.18 <1",
    "@webbpulse/qrcode": ">=0.11.0 <1",
    "emojibase-data": "^17.0.0",
    "katex": "0.16.47",
    "lowlight": "^3.3.0",
    "marked": "^18.1.1",
    "mermaid": "12.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.0",
    "@webbpulse/eslint-config": ">=0.11.0 <1",
    "@webbpulse/tsconfig": ">=0.11.0 <1",
    "emojibase": "^18.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-dom": "^5.28.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-react-x": "^5.28.4",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.0"
  }
}
