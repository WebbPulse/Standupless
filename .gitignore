# ===========================================
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

.bg-shell/
.claude/
*~
.vscode/
*.code-workspace
.env.*
!.env.example
.next/
*.pyc
target/
vendor/
.cache/
tmp/

# Playwright
playwright-report/
test-results/
.playwright-mcp/
