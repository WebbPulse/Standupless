# ===========================================
# Standupless Project .gitignore
# ===========================================

# Editor and IDE


.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Environment Variables
.env
.env.test
.env.local
.env.development.local
.env.test.local
.env.production.local

# ===========================================
# Python/FastAPI Backend
# ===========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
# Negation: frontend source directory named lib/ is NOT Python build output.
!frontend/src/lib/
!frontend/src/lib/**
sdist/
var/

*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv/
.venv

# Testing and coverage
coverage.xml
.coverage
.coverage.*
.pytest_cache/
htmlcov/
.tox/
.nox/
.cache
.mypy_cache/

# Database files
*.db
*.sqlite3


# ===========================================
# Node.js/React Frontend
# ===========================================

# Dependencies
node_modules/

# Build outputs
dist/
build/
out/

# Log files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test coverage
coverage/

# ===========================================
# Deployment & Infrastructure
# ===========================================

# Kubernetes secrets
*-secrets.yaml
scripts/output

# ===========================================
